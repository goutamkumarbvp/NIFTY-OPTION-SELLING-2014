# Paper profile: LIVE broker data + paper fills (no real orders).  Copy to .env and add the broker credentials.
TERMINAL_MODE=MANUAL
TRADING_ENV=PAPER
DATA_SOURCE=kotak            # kotak | zerodha | angel  (live data is mandatory)
BROKER=paper
MARKETS=NSE,BSE,MCX
SAFETY_GATE_OPEN_ON_START=false
LIVE_TRADING=false
LIVE_ORDERS_ENABLED=false
TERMINAL_START_TIME=09:00
TERMINAL_END_TIME=23:30
EXIT_RETRY_SECONDS=10
AGENT_CYCLE_SECONDS=10
AUTO_MIN_CONSENSUS=0.62
CANDLE_SECONDS=60
LOG_FORMAT=text
# Kotak Neo
NEO_CONSUMER_KEY=
NEO_MOBILE_NUMBER=+91XXXXXXXXXX
NEO_UCC=
NEO_MPIN=
NEO_TOTP_SECRET=
