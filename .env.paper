# Paper profile: simulator + paper broker, everything else default-safe.  Copy to .env
TERMINAL_MODE=MANUAL
TRADING_ENV=PAPER
DATA_SOURCE=simulated
BROKER=paper
SAFETY_GATE_OPEN_ON_START=false
LIVE_TRADING=false
LIVE_ORDERS_ENABLED=false
TERMINAL_START_TIME=09:00
TERMINAL_END_TIME=23:30
EXIT_RETRY_SECONDS=10
AGENT_CYCLE_SECONDS=10
AUTO_MIN_CONSENSUS=0.62
LOG_FORMAT=text
