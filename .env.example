# Copy to .env — never commit .env. All safety flags default to the safest value.

# ---- server ---------------------------------------------------------------
BIND_HOST=127.0.0.1
PORT=8600
# Required when BIND_HOST is not loopback: either a bearer token or user accounts
API_AUTH_TOKEN=
# TERMINAL_USERS=admin:change-me:admin,desk:change-me:trader,ops:change-me:viewer
LOG_LEVEL=INFO

# ---- modes & interlocks ---------------------------------------------------
TERMINAL_MODE=MANUAL          # MANUAL | AUTO  (switchable from the UI)
TRADING_ENV=PAPER             # PAPER | LIVE
LIVE_TRADING=false            # LIVE needs TRADING_ENV=LIVE + LIVE_TRADING=true + LIVE_ORDERS_ENABLED=true
LIVE_ORDERS_ENABLED=false
SAFETY_GATE_OPEN_ON_START=false
PROTECT_IN_MANUAL=true        # Sentinel may flatten in MANUAL mode on black-swan signals
MANUAL_CONFIRMATION_FOR_AGENT_ORDERS=true

# ---- market data ----------------------------------------------------------
DATA_SOURCE=simulated         # simulated | kotak | zerodha | angel
MARKETS=NSE,BSE,MCX
SIM_ALWAYS_OPEN=true          # simulated market stays open 24x7 for testing
SIM_SPEED=1.0
TICK_INTERVAL_SECONDS=1.0
FEED_STALE_SECONDS=8

# ---- broker (live only) ---------------------------------------------------
BROKER=paper                  # paper | kotak | zerodha | angel
NEO_CONSUMER_KEY=
NEO_MOBILE_NUMBER=+91XXXXXXXXXX
NEO_UCC=
NEO_MPIN=
NEO_TOTP_SECRET=
NEO_ENVIRONMENT=prod
# Zerodha Kite Connect: api key + secret from developers.kite.trade; access token is issued daily
# by scripts/zerodha_login.py (or paste a request_token once; it is single-use)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=
ZERODHA_REQUEST_TOKEN=
# Angel One SmartAPI: api key from smartapi.angelbroking.com, client code, trading PIN, TOTP secret
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=
# Live option-quote overlay (used when DATA_SOURCE=kotak, zerodha or angel)
LIVE_CHAIN_POLL_SECONDS=4
LIVE_CHAIN_UNDERLYINGS=           # blank = the council's focus list (NIFTY,BANKNIFTY,SENSEX,CRUDEOIL)

# ---- capital & risk (all editable live from the Risk panel) ---------------
CAPITAL=1000000
MAX_DAILY_LOSS=30000
MAX_DAILY_LOSS_PCT=3
DAILY_PROFIT_TARGET=0
MAX_LOTS_PER_ORDER=10
MAX_OPEN_LOTS=40
MAX_OPEN_LOTS_PER_MARKET=20
MAX_OPEN_POSITIONS=12
MAX_MARGIN_UTILISATION_PCT=70
PER_TRADE_STOP_LOSS_PCT=35
PER_TRADE_TARGET_PCT=50
TRAILING_LOCK_PCT=25
PORTFOLIO_DELTA_LIMIT=150
PORTFOLIO_VEGA_LIMIT=25000
BLACK_SWAN_SIGMA=4
BLACK_SWAN_WINDOW_MINUTES=5
VIX_SPIKE_PCT=15
NAKED_SHORT_ALLOWED=true

# ---- schedule (IST) -------------------------------------------------------
TERMINAL_START_TIME=09:00     # council and entries only inside this window
TERMINAL_END_TIME=23:30       # anything still open is squared off here
EXIT_RETRY_SECONDS=10         # unfilled square-off is re-sent every N seconds until flat
EXIT_MAX_ATTEMPTS=60
ENTRY_WINDOW_START=09:20
ENTRY_WINDOW_END=14:30
SQUARE_OFF_TIME=15:12
MCX_SQUARE_OFF_TIME=23:15
DEFAULT_LOTS=1

# ---- agents ---------------------------------------------------------------
AGENT_CYCLE_SECONDS=10
AUTO_MIN_CONSENSUS=0.62
AUTO_MIN_CONFIDENCE=0.55
AUTO_MAX_TRADES_PER_DAY=6
# Optional LLM narration of council decisions (never places orders)
LLM_ENABLED=false
LLM_PROVIDER=anthropic        # anthropic | openai
LLM_MODEL=claude-opus-5-5
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=25
COPILOT_MAX_TURNS=6           # tool-call rounds per copilot question
DECISION_SCORE_MINUTES=30     # council evaluation horizon
RECONCILE_SECONDS=60          # live broker position/margin reconciliation
LOG_FORMAT=text               # text | json

# ---- notifications --------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_COMMANDS_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
