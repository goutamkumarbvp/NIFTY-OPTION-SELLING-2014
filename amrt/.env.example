# Copy to ../.env (repository root, git-ignored). Never commit real values.
AMRT_ENVIRONMENT=PAPER_ONLY            # PAPER_ONLY | LIVE_CAPABLE
AMRT_LIVE_ORDERS_ENABLED=false         # second interlock; both are needed for any live order
AMRT_DATA_BROKER=                      # kotak | zerodha | angel | upstox | groww (read-only market data)
AMRT_UNDERLYINGS=NIFTY,SENSEX,CRUDEOIL
AMRT_SIMULATED_MARKET=false            # true = SIMULATED demo data (PAPER_ONLY only)
AMRT_PG_PASSWORD=change-me             # docker compose only
AMRT_COOKIE_SECURE=false               # true behind HTTPS
# Kotak Neo
NEO_CONSUMER_KEY=
NEO_MOBILE_NUMBER=
NEO_UCC=
NEO_MPIN=
NEO_TOTP_SECRET=
# Zerodha
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=
# Angel One
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=
# Upstox / Groww
UPSTOX_ACCESS_TOKEN=
GROWW_API_KEY=
GROWW_API_SECRET=
GROWW_ACCESS_TOKEN=
# Optional
AMRT_LLM_ENABLED=false                 # plain-language narrative of decision packages (advisory only)
ANTHROPIC_API_KEY=
AMRT_TELEGRAM_BOT_TOKEN=
AMRT_TELEGRAM_CHAT_ID=
