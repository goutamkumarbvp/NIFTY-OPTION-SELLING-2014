# Live profile template. Copy to .env and fill the credentials for ONE provider.
# All three interlocks below must be true before a single live order can leave the terminal.
TERMINAL_MODE=MANUAL
TRADING_ENV=LIVE
LIVE_TRADING=true
LIVE_ORDERS_ENABLED=true
SAFETY_GATE_OPEN_ON_START=false

# pick one provider for BOTH data and orders
DATA_SOURCE=kotak            # kotak | zerodha | angel
BROKER=kotak                 # must match DATA_SOURCE

# Kotak Neo
NEO_CONSUMER_KEY=
NEO_MOBILE_NUMBER=+91XXXXXXXXXX
NEO_UCC=
NEO_MPIN=
NEO_TOTP_SECRET=
# Zerodha (daily login: scripts/zerodha_login.py)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
# Angel One
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=

CAPITAL=1000000
MAX_DAILY_LOSS=30000
MAX_LOTS_PER_ORDER=5
MAX_OPEN_LOTS=20
MAX_MARGIN_UTILISATION_PCT=60
RECONCILE_SECONDS=60
EXIT_RETRY_SECONDS=10
TERMINAL_START_TIME=09:00
TERMINAL_END_TIME=23:30
LOG_FORMAT=json
# alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_COMMANDS_ENABLED=true
